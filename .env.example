# Example environment variables for VoiceGuard
# Copy to .env and fill in real values (never commit .env)

# Web app config (backend runs on port 3000 by default)
# Use http://localhost:3000 for laptop-only; use http://YOUR_IP:3000 for phone on same Wi-Fi
VITE_API_URL=http://localhost:3000

# Deepgram (optional): speech-to-text for ML-assisted clone detection. Free tier at https://console.deepgram.com
# VITE_DEEPGRAM_API_KEY=

# OPENAI_API_KEY=
# DATABASE_URL=
